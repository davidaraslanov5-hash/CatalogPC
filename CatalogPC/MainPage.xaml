<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CatalogPC.Services"
             xmlns:vm="clr-namespace:CatalogPC.ViewModels"
             x:Class="CatalogPC.MainPage"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>

        <Style x:Key="CardLabel" TargetType="Label">
            <Setter Property="TextColor" Value="OrangeRed"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,3,3,8"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Stroke" Value="#DDDFE3"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="MaximumWidthRequest" Value="500"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        </Style>


        <DataTemplate x:Key="CPUDataTemplate">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Metadata.Name}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Socket, StringFormat='Сокет: {0}'}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Clocks.Performance.Base , StringFormat='Частота: {0} ГГц'}" />

                    <Label Style="{StaticResource CardLabel}" Text="{Binding Cores.CoresThreads}"/>

                    <VerticalStackLayout IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ViewModelOne}}, Path=AdvancedInfo}">
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Clocks.Performance.Boost , StringFormat='Частота в бусте: {0} ГГц'}" />
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Specs.Graphics.GraphicsCore, StringFormat='Графика: {0}'}"/>
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Specs.Tdp, StringFormat='TDP: {0}W'}" />
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Specs.ECCMemorySupport, StringFormat='Поддержка ECC: {0}'}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GPUDataTemplate">
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding AdvancedInfo}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Metadata.Name}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Memory, StringFormat='Видеопамять: {0}GB '}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding MemoryType, StringFormat='Тип памяти: {0}'}"/>

                    <VerticalStackLayout IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ViewModelOne}}, Path=AdvancedInfo}">
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Tdp, StringFormat='TDP: {0}W'}" />
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding MemoryBus, StringFormat='Шина памяти: {0}'}" />
                        <Label TextColor="Orange" Style="{StaticResource CardLabel}" Text="{Binding Interface, StringFormat='Интерфейс: {0}'}" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        
        <DataTemplate x:Key="BoardDataTemplate">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Metadata.Name}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Socket, StringFormat='Сокет: {0}'}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Memory.RamType, StringFormat='Тип памяти: {0}'}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Memory.Slots, StringFormat='Слоты памяти: {0}'}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Memory.Max, StringFormat='Максимум ОЗУ: {0}GB'}"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        
        <DataTemplate x:Key="RAMDataTemplate">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Metadata.Name}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding Module.CapacityGB_x1, StringFormat='1 планка: {0}GB '}"/>
                    <Label Style="{StaticResource CardLabel}" Text="{Binding MemoryType, StringFormat='Формат: {0}'}"/>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>


        <local:ComponentSelector x:Key="ComponentSelector"
               CPUDataTemplate="{StaticResource CPUDataTemplate}"
               GPUDataTemplate="{StaticResource GPUDataTemplate}" 
               BoardDataTemplate ="{StaticResource BoardDataTemplate}"
               RAMDataTemplate ="{StaticResource RAMDataTemplate}"/>
    </ContentPage.Resources>

    <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
        <Grid RowDefinitions="Auto,Auto,*" Padding="30,0" RowSpacing="25">
            <HorizontalStackLayout Grid.Row="0" Spacing="25" HorizontalOptions="Center" Margin="0,30,0,0"
                                   RadioButtonGroup.GroupName="Components"
                                    RadioButtonGroup.SelectedValue="{Binding SelectedComponents}">
                <Entry
                    HorizontalOptions="Center"
                    WidthRequest="400"
                    Background="White"
                    TextColor="Black"
                    Placeholder="Введите запрос..."
                    PlaceholderColor="Gray"
                    Text="{Binding NameFile, Mode=TwoWay}"
                ></Entry>
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Видеокарты"
                    GroupName="Components"
                    Value="GPU"
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Процессоры"
                    GroupName="Components"
                    Value="CPU"
                    
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Материнские платы"
                    GroupName="Components"
                    Value="Board"
                    
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Память"
                    GroupName="Components"
                    Value="RAM"
                    
                />
                <Button
                    Background="OrangeRed"
                    TextColor="White"
                    Text="{Binding ShowTextInfo}"
                    Command="{Binding ExtraInfoCommand}"
                    ></Button>

            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Spacing="80" HorizontalOptions="Center">
                <!-- CornerRadius = скругление кнопок, HeightRequest = высота -->
                <Button
                    TextColor="White"
                    Text="Поиск"
                    WidthRequest="200"
                    HeightRequest="45"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    Background="OrangeRed"
                    Command="{Binding TestCommand}"
                    ></Button>
                <Border Stroke="#DDDFE3"
                    BackgroundColor="White"
                    Padding="15"
                    MaximumWidthRequest="500"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout>
                        <Label
                FontAttributes="Bold"
                TextColor="Black"
                Text="{Binding CompatibilityMessage}" ></Label>
                    </VerticalStackLayout>
                </Border>
                <Border
                    Stroke="#DDDFE3"
                            BackgroundColor="White"
                            Padding="15"
                            MaximumWidthRequest="500"
                            StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Cpu_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Gpu_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Board_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Ram_}"    
                        ></Label>
                        <HorizontalStackLayout>
                            <Button BackgroundColor="#F4F5F7" TextColor="Black" Text="-" Command="{Binding DeleteOneRAMCommand}" IsVisible="{Binding IsRAM}"></Button>
                            <Button BackgroundColor="#F4F5F7" TextColor="Black" Text="+" Command="{Binding AddOneRAMCommand}" IsVisible="{Binding IsRAM}"></Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button
                TextColor="White"
                Text="Тест совместимости"
                WidthRequest="200"
                HeightRequest="45"
                CornerRadius="12"
                FontAttributes="Bold"
                Background="OrangeRed"
                Command="{Binding CompatibilityTestCommand}"
                ></Button>
            </HorizontalStackLayout>
        </Grid>
        <VerticalStackLayout>
            <CollectionView
                HeightRequest="700"
                Grid.Row="2"
                SelectionMode="Single"
                SelectionChangedCommand="{Binding AddPartCommand}"
                SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}" 
                ItemsSource="{Binding ResultsSearch}" 
                ItemTemplate="{StaticResource ComponentSelector}"
                RemainingItemsThreshold="25"
                Scrolled="OnResultsScrolled"
                x:Name="Results">
                <CollectionView.ItemsLayout>
                    
                    <GridItemsLayout 
                                    Span="3"
                                    Orientation="Vertical"
                                     VerticalItemSpacing="15"
                                     HorizontalItemSpacing="15"
                                     />
                    
                </CollectionView.ItemsLayout>
            </CollectionView>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
