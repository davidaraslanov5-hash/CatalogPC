<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CatalogPC.Services"
             x:Class="CatalogPC.MainPage"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <DataTemplate x:Key="CPUDataTemplate">
            <Border Stroke="#DDDFE3"
                BackgroundColor="White"
                Padding="15"
                MaximumWidthRequest="500"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Metadata.Name}"
                       FontSize="16"
                       Padding="3,3,3,8"
                     >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                            Path=BindingContext.AddPartCommand}"
                            CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Socket, StringFormat='Сокет: {0}'}"
                        FontSize="16"
                        Padding="3,3,3,8"
                    ></Label>
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Cores.Total, StringFormat='Ядра: {0}'}"
                       FontSize="16"
                       Padding="3,3,3,8"
                   ></Label>
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Cores.Threads, StringFormat='Потоки: {0}'}"
                        FontSize="16"
                        Padding="3,3,3,8"
                    ></Label>
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Specs.Graphics.GraphicsCore, StringFormat='Графика: {0}'}"
                        FontSize="16"
                        Padding="3,3,3,8"
                    ></Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GPUDataTemplate">
            <Border Stroke="#DDDFE3"
                BackgroundColor="White"
                Padding="15"
                MaximumWidthRequest="500"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Metadata.Name}"
                        FontSize="16"
                        Padding="3,3,3,8"
                      >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                 Path=BindingContext.AddPartCommand}"
                                 CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Memory, StringFormat='Видеопамять: {0}GB '}"
                       FontSize="16"
                       Padding="3,3,3,8"
                    ></Label>
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding MemoryType, StringFormat='Тип памяти: {0}'}"
                       FontSize="16"
                       Padding="3,3,3,8"
                    ></Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BoardDataTemplate">
            <Border Stroke="#DDDFE3"
                BackgroundColor="White"
                Padding="15"
                MaximumWidthRequest="500"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Metadata.Name}"
                        FontSize="16"
                        Padding="3,3,3,8"
                      >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                 Path=BindingContext.AddPartCommand}"
                                 CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Socket, StringFormat='Сокет: {0}'}"
                       FontSize="16"
                       Padding="3,3,3,8"
                    ></Label>
                    <Label
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Memory.RamType, StringFormat='Тип памяти: {0}'}"
                       FontSize="16"
                       Padding="3,3,3,8"
                    ></Label>
                    <Label
                        TextColor="OrangeRed"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Memory.Slots, StringFormat='Слоты памяти: {0}'}"
                        FontSize="16"
                        Padding="3,3,3,8"
                     ></Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        
        <DataTemplate x:Key="RAMDataTemplate">
            <Border Stroke="#DDDFE3"
                BackgroundColor="White"
                Padding="15"
                MaximumWidthRequest="500"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label
                            TextColor="OrangeRed"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Metadata.Name}"
                            FontSize="16"
                            Padding="3,3,3,8"
                          >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                 Path=BindingContext.AddPartCommand}"
                                 CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>


        <local:ComponentSelector x:Key="ComponentSelector"
               CPUDataTemplate="{StaticResource CPUDataTemplate}"
               GPUDataTemplate="{StaticResource GPUDataTemplate}" 
               BoardDataTemplate ="{StaticResource BoardDataTemplate}"
               RAMDataTemplate ="{StaticResource RAMDataTemplate}"/>
    </ContentPage.Resources>

        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">


            

        <Grid RowDefinitions="Auto,Auto,*" Padding="30,0" RowSpacing="25">
            <HorizontalStackLayout Grid.Row="0" Spacing="25" HorizontalOptions="Center" Margin="0,30,0,0"
                                   RadioButtonGroup.GroupName="Components"
                                    RadioButtonGroup.SelectedValue="{Binding SelectedComponents}">
                <Entry
                HorizontalOptions="Center"
                WidthRequest="400"
                Background="White"
                TextColor="Black"
                Placeholder="Введите запрос..."
                PlaceholderColor="Gray"
                Text="{Binding NameFile, Mode=TwoWay}"
                ></Entry>
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Видеокарты"
                    GroupName="Components"
                    Value="GPU"
                    IsChecked="{Binding OnlyGPU}"
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Процессоры"
                    GroupName="Components"
                    Value="CPU"
                    IsChecked="{Binding OnlyCPU}"
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Материнские платы"
                    GroupName="Components"
                    Value="Board"
                    IsChecked="{Binding OnlyBoard}"
                />
                <RadioButton
                    WidthRequest="120"
                    CornerRadius="12"
                    Background="OrangeRed"
                    TextColor="White"
                    Content="Память"
                    GroupName="Components"
                    Value="RAM"
                    IsChecked="{Binding OnlyRAM}"
                />

            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Spacing="80" HorizontalOptions="Center">
                <!-- CornerRadius = скругление кнопок, HeightRequest = высота -->
                <Button
                    TextColor="White"
                    Text="Поиск"
                    WidthRequest="200"
                    HeightRequest="45"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    Background="OrangeRed"
                    Command="{Binding TestCommand}"
                    ></Button>
                <Border Stroke="#DDDFE3"
                    BackgroundColor="White"
                    Padding="15"
                    MaximumWidthRequest="500"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout>
                        <Label
                FontAttributes="Bold"
                TextColor="Black"
                Text="{Binding CompatibilityMessage}" ></Label>
                    </VerticalStackLayout>
                </Border>
                <Border
                    Stroke="#DDDFE3"
                            BackgroundColor="White"
                            Padding="15"
                            MaximumWidthRequest="500"
                            StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Cpu_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Gpu_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Board_}"    
                        ></Label>
                        <Label
                             FontAttributes="Bold"
                            TextColor="Black"
                            Text="{Binding Ram_}"    
                        ></Label>
                        <HorizontalStackLayout>
                            <Button BackgroundColor="#F4F5F7" TextColor="Black" Text="-" Command="{Binding DeleteOneRAMCommand}"></Button>
                            <Button BackgroundColor="#F4F5F7" TextColor="Black" Text="+" Command="{Binding AddOneRAMCommand}"></Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button
                TextColor="White"
                Text="Тест совместимости"
                WidthRequest="200"
                HeightRequest="45"
                CornerRadius="12"
                FontAttributes="Bold"
                Background="OrangeRed"
                Command="{Binding CompatibilityTestCommand}"
                ></Button>
            </HorizontalStackLayout>
        </Grid>
            
            
            <CollectionView ItemsSource="{Binding ResultsSearch}" ItemTemplate="{StaticResource ComponentSelector}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     VerticalItemSpacing="15"
                                     HorizontalItemSpacing="15"
                                     />
                </CollectionView.ItemsLayout>
            </CollectionView>

        </VerticalStackLayout>
</ContentPage>
